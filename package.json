{
  "name": "sapling-seeds-root",
  "version": "1.0.0",
  "description": "Root of the Sapling Seeds monorepo",
  "type": "module",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd sapling-seeds && npm run dev",
    "dev:admin": "cd admin-portal && npm run dev",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "dev": "node server.js",
    "build:prod": "node scripts/build-prod.js",
    "start": "node server.js",
    "prod": "node server.js",
    "install:all": "npm install && cd backend && npm install && cd ../sapling-seeds && npm install && cd ../admin-portal && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.0",
    "mongoose": "^7.5.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "openssl": "^2.0.0",
    "react-oauth": "^0.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "keywords": [
    "api",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
