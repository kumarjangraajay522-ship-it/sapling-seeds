Options -Indexes

# MIME types
AddType application/javascript .js
AddType text/css .css

# Fix Google OAuth popup COOP issue
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

RewriteEngine On
RewriteBase /

# Proxy /api/ requests to the Node.js backend on port 5000
RewriteRule ^api/(.*)$ http://localhost:5000/api/$1 [P,L]

# Serve the built index.html for root requests
RewriteRule ^$ dist/index.html [L]
RewriteRule ^index\.html$ dist/index.html [L]

# Allow direct access to dist/ and admin-portal/
RewriteRule ^dist/ - [L]
RewriteRule ^admin-portal/ - [L]

# Rewrite /assets/* to /dist/assets/*
RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

# Rewrite known static files to their dist/ copies
RewriteRule ^(cursor\.png|robots\.txt|sitemap\.xml|llms\.txt|_redirects)$ dist/$1 [L]

# SPA fallback — let React Router handle all other paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . dist/index.html [L]
